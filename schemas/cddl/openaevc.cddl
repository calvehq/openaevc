; OpenAEVC protocol 0.1.0 — CDDL for canonical CBOR (RFC 8610).
; Generated by tooling/generate-schemas from the protocol types; do not edit.
; The canonical data model mirrors JSON: text keys, no floats, no null,
; integers within +/-(2^53-1), binary values as unpadded base64url text.

activeedge = { "from": noderef, "to": noderef, "kind": activeedgekind, ? "annotations": { * tstr => any } }
activeedgekind = ("DEPENDS_ON" / "BLOCKS" / "PRODUCES" / "CONSUMES" / "DERIVED_FROM" / "VERIFIES" / "EVALUATES" / "REVISION_OF")
appliedeffect = { "id": effectid, "work_unit": workunitid, "kind": tstr, "target": resourceref, "payload": any, ? "preconditions": [* any], ? "outputs": [* resourceref], "outcome": any, "provenance": provenance }
baseline = { "id": baselineid, "members": [* digest], ? "edges": [* compositionedge], "heads": [* digest], ? "policies": [* digest], ? "facts": { * tstr => factvalue }, "graph_digest": digest, ? "metadata": { * tstr => any } }
baselineid = tstr .regexp "^bsl_[a-z2-7]{26}$"
blob = { "media_type": tstr, "data": tstr }
candidate = { "pack": packid, "generation": uint, "effects": [* appliedeffect] }
changepack = { "id": packid, "namespace": namespaceid, "generation": uint, "state": packstate, "created_by": principalid, "created_at": timestamp, "updated_at": timestamp, ? "intent": any, ? "resource_refs": [* resourceref], ? "work_units": [* workunit], ? "required_policies": [* digest], ? "extension_bindings": [* tstr], ? "conflicts_with": [* digest], ? "revision": revisioninfo, ? "candidate_effects": [* appliedeffect], ? "sealed": sealinfo, ? "qualification": qualificationinfo, ? "quarantine": quarantineinfo, ? "promotion": promotioninfo, ? "metadata": { * tstr => any } }
command = ({ "root_principals": [* newprincipal], ? "metadata": { * tstr => any }, "type": "CreateNamespace" } / { "principal": newprincipal, "type": "RegisterPrincipal" } / { "grant": signedgrant, "type": "IssueCapabilityGrant" } / { "grant": grantid, ? "reason": tstr, "type": "RevokeCapabilityGrant" } / { "document": policydocument, ? "mandatory": bool, "type": "RegisterPolicy" } / { "entrypoint": tstr, "artifact_digest": digest, ? "approved_host_capabilities": [* hostcapability], "type": "RegisterExtension" } / { "extension": tstr, "type": "UnregisterExtension" } / { "provider": providerdescriptor, "type": "RegisterProvider" } / { ? "spec": packspec, "type": "CreateChangePack" } / { "relation": revisionrelation, "targets": [* digest], ? "spec": packspec, "type": "CreateRevisionPack" } / { "pack": packid, "expected_generation": uint, ? "intent": any, ? "resource_refs": [* resourceref], ? "required_policies": [* digest], ? "extension_bindings": [* tstr], ? "conflicts_with": [* digest], ? "metadata": { * tstr => any }, "type": "UpdateChangePack" } / { "pack": packid, "expected_generation": uint, "kind": tstr, ? "spec": any, ? "depends_on": [* noderef], "type": "AddWorkUnit" } / { "pack": packid, "expected_generation": uint, "work_unit": workunitid, ? "spec": any, ? "state": workunitstate, "type": "UpdateWorkUnit" } / { "pack": packid, "expected_generation": uint, "from": noderef, "to": noderef, "kind": activeedgekind, ? "annotations": { * tstr => any }, "type": "AddActiveDependency" } / { "pack": packid, "expected_generation": uint, "from": noderef, "to": noderef, "kind": activeedgekind, "type": "RemoveActiveDependency" } / { "pack": packid, "expected_generation": uint, "type": "SealChangePack" } / { "pack": packid, "expected_generation": uint, "type": "ReopenChangePack" } / { "pack": packid, "expected_generation": uint, "type": "AbandonChangePack" } / { "pack": packid, "reason": tstr, "type": "QuarantineChangePack" } / { "pack": packid, "type": "ReleaseQuarantine" } / { "request": executionrequest, "type": "StartExecution" } / { "execution": executionid, "lease": leaseid, "generation": uint, "type": "HeartbeatExecution" } / { "execution": executionid, ? "reason": tstr, "type": "CancelExecution" } / { "execution": executionid, "lease": leaseid, "effect": effectproposal, "type": "SubmitEffectProposal" } / { "execution": executionid, "lease": leaseid, "kind": tstr, ? "payload": any, ? "blob": blob, ? "related_resources": [* resourceref], ? "related_effects": [* effectid], "type": "AppendObservation" } / { "execution": executionid, "lease": leaseid, "type": "CompleteExecution" } / { "execution": executionid, "lease": leaseid, "reason": tstr, "type": "FailExecution" } / { "pack": packid, "generation": uint, "candidate": digest, "kind": tstr, "payload": blob, ? "schema": schemaref, ? "sources": [* noderef], ? "extension": tstr, "type": "RegisterEvidence" } / { "pack": packid, "generation": uint, "verifier": tstr, ? "config": any, ? "evidence": [* digest], "type": "RunVerification" } / { "pack": packid, "generation": uint, "evaluator": tstr, ? "config": any, ? "inputs": [* digest], "type": "RunEvaluation" } / { "pack": packid, "generation": uint, "type": "RefreshQualification" } / { "pack": packid, "generation": uint, "type": "PromoteChangePack" } / { "members": [* digest], ? "edges": [* compositionedge], ? "policies": [* digest], ? "metadata": { * tstr => any }, "type": "CreateBaseline" } / { "digest": digest, "bytes": tstr, "type": "PutImmutableObject" })
commandenvelope = { "protocol_version": protocolversion, "request_id": requestid, ? "namespace": namespaceid, "caller": principalid, ? "act_as": principalid, "nonce": tstr, "issued_at": timestamp, ? "expires_at": timestamp, "body": command, ? "signature": signature }
commandreceipt = { "receipt": digest, "request_id": requestid, "result": commandresult, "first_seq": uint, "last_seq": uint }
commandresult = { ? "id": tstr, ? "ids": [* tstr], ? "digest": digest, ? "digests": [* digest], ? "generation": uint, ? "state": tstr, ? "lease": lease }
compositionedge = { "from": digest, "to": digest, "kind": compositionedgekind, ? "relation": revisionrelation }
compositionedgekind = ("REQUIRES" / "ORDERS_AFTER" / "CONFLICTS_WITH" / "REVISION_RELATION")
decisionoutcome = ("ALLOW" / "DENY")
digest = tstr .regexp "^sha256:[0-9a-f]{64}$"
effectid = tstr .regexp "^eff_[a-z2-7]{26}$"
effectkinddecl = { "kind": tstr, "resource_kind": tstr, "required_actions": [* tstr] }
effectproposal = { "kind": tstr, "target": resourceref, "payload": any, ? "preconditions": [* any], ? "outputs": [* resourceref] }
effectsummary = { "kind": tstr, "target": resourceref }
entrypoint = { "command": tstr, ? "args": [* tstr] }
errorcategory = ("REQUEST" / "AUTHORITY" / "LIFECYCLE" / "GRAPH" / "EXECUTION" / "EXTENSION" / "QUALIFICATION" / "CONFLICT" / "INTEGRITY" / "INTERNAL")
errorcode = ("INVALID_ARGUMENT" / "NOT_FOUND" / "ALREADY_EXISTS" / "UNAUTHORIZED" / "FORBIDDEN" / "CAPABILITY_EXPIRED" / "CAPABILITY_REVOKED" / "REPLAY_DETECTED" / "STALE_GENERATION" / "INVALID_TRANSITION" / "IMMUTABLE_OBJECT" / "QUARANTINED" / "DEPENDENCY_CYCLE" / "DEPENDENCY_MISSING" / "EXECUTION_NOT_READY" / "EXECUTION_LOST" / "EXTENSION_INCOMPATIBLE" / "EXTENSION_FAILED" / "EVIDENCE_INVALID" / "VERIFICATION_FAILED" / "POLICY_DENIED" / "NOT_QUALIFIED" / "COMPOSITION_INVALID" / "CONFLICT" / "DIGEST_MISMATCH" / "CANONICAL_ENCODING_ERROR" / "PROTOCOL_VERSION_UNSUPPORTED" / "STORAGE_INTEGRITY_ERROR" / "RECOVERY_REQUIRED" / "INTERNAL")
evaluationid = tstr .regexp "^evl_[a-z2-7]{26}$"
evaluationresult = { "id": evaluationid, "pack": packid, "generation": uint, "candidate": digest, "evaluator": tstr, ? "extension": extensionref, ? "config": any, "verdict": evaluationverdict, ? "metrics": { * tstr => int }, ? "facts": { * tstr => factvalue }, ? "inputs": [* digest], "started_at": timestamp, "finished_at": timestamp, "provenance": runprovenance }
evaluationverdict = ("ALLOW" / "WARN" / "DENY" / "UNKNOWN")
evaluatorcondition = { "kind": tstr, "verdict": evaluationverdict }
event = { "id": eventid, "namespace": namespaceid, "sequence": uint, "runtime_instance": runtimeinstanceid, ? "request_id": requestid, ? "actor": principalid, "kind": tstr, "body": any, ? "subjects": [* tstr], "timestamp": timestamp, "previous_hash": digest, "hash": digest }
eventfilter = { "namespace": namespaceid, ? "after": uint, ? "kinds": [* tstr], ? "subjects": [* tstr] }
eventid = tstr .regexp "^evt_[a-z2-7]{26}$"
evidence = { "id": evidenceid, "kind": tstr, "producer": principalid, "pack": packid, "generation": uint, "candidate": digest, "payload": digest, "media_type": tstr, ? "schema": schemaref, ? "sources": [* noderef], ? "extension": extensionref, "created_at": timestamp }
evidencecondition = { "kind": tstr }
evidenceid = tstr .regexp "^evd_[a-z2-7]{26}$"
execution = { "id": executionid, "namespace": namespaceid, "pack": packid, "generation": uint, "work_unit": workunitid, "actor": principalid, "provider": tstr, "harness": tstr, ? "worker": workerinfo, "state": executionstate, ? "allowed_resources": [* resourceselector], ? "allowed_effects": [* tstr], ? "grants": [* digest], ? "extensions": [* extensionref], ? "context": [* digest], "timeout_ms": uint, ? "budget": { * tstr => int }, "max_attempts": uint, "attempt": uint, "idempotency_key": tstr, ? "retry_of": executionid, ? "lease": lease, "request_id": requestid, "created_at": timestamp, "updated_at": timestamp, ? "finished_at": timestamp, ? "failure": tstr, ? "effects": [* effectid], ? "observations": [* observationid] }
executionid = tstr .regexp "^exe_[a-z2-7]{26}$"
executionrequest = { "pack": packid, "expected_generation": uint, "work_unit": workunitid, "provider": tstr, "harness": tstr, ? "worker": workerinfo, ? "allowed_resources": [* resourceselector], ? "allowed_effects": [* tstr], ? "context": [* digest], "timeout_ms": uint, ? "budget": { * tstr => int }, "max_attempts": uint, "idempotency_key": tstr, ? "retry_of": executionid }
executionstate = ("PENDING" / "ADMITTED" / "STARTING" / "RUNNING" / "SUCCEEDED" / "FAILED" / "CANCELLED" / "LOST")
expr = ({ "all": [* expr] } / { "any": [* expr] } / { "not": expr } / { "eq": factcompare } / { "ne": factcompare } / { "lt": intcompare } / { "le": intcompare } / { "gt": intcompare } / { "ge": intcompare } / { "in": factin } / { "contains": factcontains } / { "exists": factname } / { "verifier": verifiercondition } / { "evaluator": evaluatorcondition } / { "evidence": evidencecondition })
extensionerrorinfo = { "extension_id": tstr, "code": tstr, "message": tstr }
extensionmanifest = { "id": tstr, "version": tstr, "protocol": versionrange, "contract": versionrange, ? "publisher": publickey, "artifact_digest": digest, ? "resource_kinds": [* resourcekinddecl], ? "effect_kinds": [* effectkinddecl], ? "verifier_kinds": [* tstr], ? "evaluator_kinds": [* tstr], ? "composition_validators": [* tstr], ? "host_capabilities": [* hostcapability], ? "schemas": { * tstr => digest }, "execution_modes": [* tstr], "entrypoint": entrypoint }
extensionref = { "id": tstr, "version": tstr, "manifest_digest": digest }
factcompare = { "fact": tstr, "value": factvalue }
factcontains = { "fact": tstr, "value": tstr }
factin = { "fact": tstr, "values": [* factvalue] }
factname = { "fact": tstr }
factvalue = (bool / int / tstr / [* tstr])
finding = { "code": tstr, "message": tstr, ? "resource": resourceref }
grantbody = { "id": grantid, "namespace": namespaceid, "issuer": principalid, "subject": principalid, "actions": [* tstr], ? "resources": [* resourceselector], ? "constraints": { * tstr => any }, "not_before": timestamp, "expires_at": timestamp, "delegation_depth": uint, ? "parent": digest, "nonce": tstr }
grantid = tstr .regexp "^grt_[a-z2-7]{26}$"
hostcapability = ("resource.read" / "resource.write" / "process.execute" / "network.connect" / "secret.read" / "clock.read" / "entropy.read")
implementationinfo = { "name": tstr, "version": tstr }
intcompare = { "fact": tstr, "value": int }
journalcheckpoint = { "sequence": uint, "event_hash": digest, "runtime_key": publickey, "runtime_instance": runtimeinstanceid, "created_at": timestamp }
lease = { "id": leaseid, "execution": executionid, "generation": uint, "provider": tstr, "expires_at": timestamp, "heartbeat_interval_ms": uint }
leaseid = tstr .regexp "^lse_[a-z2-7]{26}$"
namespace = { "id": namespaceid, "created_at": timestamp, "created_by": principalid, "root_principals": [* principalid], ? "mandatory_policies": [* digest], ? "metadata": { * tstr => any } }
namespaceid = tstr .regexp "^ns_[a-z2-7]{26}$"
newprincipal = { "kind": principalkind, ? "public_key": publickey, ? "linked_to": principalid, ? "attributes": { * tstr => tstr } }
noderef = tstr .regexp "^([a-z]{2,3}_[a-z2-7]{26}|sha256:[0-9a-f]{64})$"
objectenvelope = { "kind": objectkind, "protocol_version": protocolversion, "namespace": namespaceid, ? "id": tstr, "created_seq": uint, "creator": principalid, "body": any, ? "signatures": [* signatureentry] }
objectkind = ("blob" / "capability_grant" / "revocation" / "policy_document" / "policy_decision" / "extension_manifest" / "candidate" / "observation" / "evidence" / "verification_result" / "evaluation_result" / "promoted_pack" / "promotion_record" / "receipt" / "baseline" / "journal_checkpoint")
observation = { "id": observationid, "execution": executionid, "pack": packid, "generation": uint, "work_unit": workunitid, "producer": principalid, "observed_at": timestamp, "kind": tstr, ? "payload": any, ? "blob": digest, ? "related_resources": [* resourceref], ? "related_effects": [* effectid], "provenance": provenance }
observationid = tstr .regexp "^obs_[a-z2-7]{26}$"
packid = tstr .regexp "^(cpk|rpk)_[a-z2-7]{26}$"
packspec = { ? "intent": any, ? "resource_refs": [* resourceref], ? "required_policies": [* digest], ? "extension_bindings": [* tstr], ? "conflicts_with": [* digest], ? "metadata": { * tstr => any } }
packstate = ("OPEN" / "SEALED" / "QUALIFIED" / "PROMOTED" / "ABANDONED" / "QUARANTINED")
policydecision = { "pack": packid, "generation": uint, "candidate": digest, "policies": [* digest], ? "facts": { * tstr => factvalue }, "outcome": decisionoutcome, "rules": [* ruleresult], "evaluated_at": timestamp }
policydocument = { "name": tstr, ? "description": tstr, "rules": [* policyrule] }
policyrule = { "id": tstr, "expr": expr }
principal = { "id": principalid, "namespace": namespaceid, "kind": principalkind, ? "public_key": publickey, ? "linked_to": principalid, ? "attributes": { * tstr => tstr }, "registered_at": timestamp }
principalid = tstr .regexp "^pri_[a-z2-7]{26}$"
principalkind = ("KEY" / "RUNTIME" / "SERVICE" / "ACTOR")
promotedpack = { "pack": packid, "generation": uint, "candidate": digest, "effects": [* effectsummary], ? "resources": [* resourceref], ? "dependencies": [* digest], ? "conflicts_with": [* digest], ? "revision": revisioninfo, ? "verifications": [* digest], ? "evaluations": [* digest], ? "evidence": [* digest], "policy_decisions": [* digest], "promotion_record": digest, ? "extensions": [* extensionref], ? "intent": any, ? "metadata": { * tstr => any }, "provenance_root": digest }
promotionid = tstr .regexp "^pro_[a-z2-7]{26}$"
promotioninfo = { "promoted_pack": digest, "promotion_record": digest }
promotionrecord = { "id": promotionid, "pack": packid, "generation": uint, "candidate": digest, "policy_decision": digest, "promoted_by": principalid, "promoted_at": timestamp, "request_id": requestid }
protocolerror = { "code": errorcode, "category": errorcategory, "message": tstr, "retryable": bool, ? "object_ids": [* tstr], ? "expected_generation": uint, ? "actual_generation": uint, ? "missing_action": tstr, ? "transition": transitioninfo, ? "extension_error": extensionerrorinfo, ? "cycle": [* tstr] }
protocolversion = tstr .regexp "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
provenance = { "actor": principalid, "caller": principalid, "provider": tstr, ? "worker": tstr, "harness": tstr, ? "extension": extensionref, ? "grants": [* digest], "request_id": requestid, "pack": packid, "generation": uint, "execution": executionid, "runtime_instance": runtimeinstanceid, ? "inputs": [* digest] }
providerdescriptor = { "id": tstr, "version": tstr, "worker_kinds": [* tstr], "harnesses": [* tstr], ? "required_actions": [* tstr], "cancellation": bool, "resumable": bool, "heartbeat": bool, ? "limits": { * tstr => int }, ? "provenance_fields": [* tstr], "principal": principalid }
publickey = tstr .regexp "^ed25519:[A-Za-z0-9_-]{43}$"
qualificationinfo = { "generation": uint, "candidate": digest, "decision": digest }
quarantineinfo = { "previous_state": packstate, "reason": tstr, "by": principalid, "at": timestamp }
query = ({ "type": "GetRuntimeInfo" } / { "type": "GetNamespace" } / { "principal": principalid, "type": "GetPrincipal" } / { "grant": grantid, "type": "GetGrant" } / { "principal": principalid, "action": tstr, ? "resource": resourceref, "type": "Authorize" } / { "pack": packid, ? "generation": uint, "type": "GetChangePack" } / { "pack": packid, ? "generation": uint, "type": "GetRevisionPack" } / { ? "pack": packid, "type": "GetActiveChangeGraph" } / { "node": noderef, "type": "GetNode" } / { "node": noderef, ? "reverse": bool, "type": "GetDependencyClosure" } / { "node": noderef, "type": "GetAffectedNodes" } / { ? "pack": packid, "type": "GetReadyWork" } / { ? "pack": packid, "type": "GetBlockedWork" } / { "execution": executionid, "type": "GetExecution" } / { ? "pack": packid, ? "state": executionstate, "type": "ListExecutions" } / { "digest": digest, "type": "GetEvidence" } / { "digest": digest, "type": "GetVerification" } / { "digest": digest, "type": "GetEvaluation" } / { "digest": digest, "type": "GetPolicyDecision" } / { ? "pack": packid, ? "digest": digest, "type": "GetPromotedPack" } / { "baseline": baselineid, "type": "GetBaseline" } / { "digest": digest, "type": "ValidateBaseline" } / { "baseline": baselineid, "type": "GetBaselineClosure" } / { "digest": digest, "type": "GetObjectClosure" } / { "digest": digest, "type": "GetPackClosure" } / { "digest": digest, "type": "GetObject" } / { "digests": [* digest], "type": "HasObject" } / { "digests": [* digest], "type": "ComputeMissingObjects" } / { ? "kind": objectkind, ? "after": digest, ? "limit": uint, "type": "ListObjectDigests" } / { ? "after": uint, ? "limit": uint, ? "kinds": [* tstr], "type": "ListEvents" } / { "type": "GetJournalCheckpoint" } / { "type": "ListExtensions" })
queryenvelope = { "protocol_version": protocolversion, "request_id": requestid, ? "namespace": namespaceid, "caller": principalid, ? "act_as": principalid, "nonce": tstr, "issued_at": timestamp, ? "expires_at": timestamp, "body": query, ? "signature": signature }
receipt = { "request_id": requestid, "command": tstr, "caller": principalid, "envelope_digest": digest, "result": commandresult, "first_seq": uint, "last_seq": uint, "runtime_instance": runtimeinstanceid, "completed_at": timestamp }
requestid = tstr .regexp "^req_[a-z2-7]{26}$"
resourcekinddecl = { "kind": tstr, ? "description": tstr }
resourceref = { "kind": tstr, "locator": tstr, ? "version": digest, "extension": tstr }
resourceselector = { "kind": tstr, ? "locator_prefix": tstr }
revisioninfo = { "relation": revisionrelation, "targets": [* digest] }
revisionrelation = ("AMENDS" / "SUPERSEDES" / "REVERTS")
revocation = { "grant": grantid, "grant_digest": digest, "revoked_by": principalid, "revoked_at": timestamp, ? "reason": tstr }
ruleresult = { "policy": digest, "rule": tstr, "passed": bool }
runprovenance = { "caller": principalid, "request_id": requestid, "runtime_instance": runtimeinstanceid }
runtimeinfo = { "protocol": versionrange, "contract": versionrange, "implementation": implementationinfo, "runtime_instance": runtimeinstanceid, "runtime_key": publickey, "replay_window_ms": uint }
runtimeinstanceid = tstr .regexp "^rti_[a-z2-7]{26}$"
schemaref = { "id": tstr, "version": tstr }
sealinfo = { "generation": uint, "candidate": digest, "sealed_at": timestamp }
signature = tstr .regexp "^[A-Za-z0-9_-]{86}$"
signatureentry = { "public_key": publickey, "signature": signature }
signedgrant = { "body": grantbody, "signature": signature }
timestamp = tstr .regexp "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
transitioninfo = { "from": tstr, "to": tstr }
verificationid = tstr .regexp "^vrf_[a-z2-7]{26}$"
verificationresult = { "id": verificationid, "pack": packid, "generation": uint, "candidate": digest, "verifier": tstr, ? "extension": extensionref, ? "config": any, "status": verificationstatus, ? "evidence": [* digest], ? "findings": [* finding], ? "facts": { * tstr => factvalue }, "started_at": timestamp, "finished_at": timestamp, "provenance": runprovenance }
verificationstatus = ("PASS" / "FAIL" / "INCONCLUSIVE" / "ERROR")
verifiercondition = { "kind": tstr, "status": verificationstatus }
versionrange = { "min": protocolversion, "max": protocolversion }
workunit = { "id": workunitid, "kind": tstr, ? "spec": any, "state": workunitstate }
workunitid = tstr .regexp "^wku_[a-z2-7]{26}$"
workunitstate = ("OPEN" / "COMPLETED" / "CANCELLED")
workerinfo = { "id": tstr, "kind": tstr, ? "attributes": { * tstr => tstr } }
